---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
---
<Layout>
  <TerminalWindow>
    <section id="accueil" data-section class="section">
      <h1>accueil</h1>
      <p>Bienvenue sur mon portfolio. Je suis Hasinirina Jean de Dieu, développeur informatique passionné par la création de solutions web et logicielles.</p>
    </section>

    <section id="profil" data-section class="section">
      <h2>profil</h2>
      <p>Étudiant en M1 à l'ENI Fianarantsoa, je développe des projets axés sur l'expérience utilisateur, la performance et la qualité du code.</p>
    </section>

    <section id="competences" data-section class="section">
      <h2>competences</h2>
      <ul>
        <li>HTML / CSS / JavaScript</li>
        <li>Astro / React / TypeScript</li>
        <li>Développement backend et architecture logicielle</li>
      </ul>
    </section>

    <section id="projets" data-section class="section">
      <h2>projets</h2>
      <p>Je conçois des interfaces modernes, des applications web et des outils utiles pour accompagner des projets numériques.</p>
    </section>

    <section id="formation" data-section class="section">
      <h2>formation</h2>
      <p>Formation en informatique, suivi de projets pratiques orientés développement, sécurité et innovation technologique.</p>
    </section>

    <section id="contact" data-section class="section">
      <h2>contact</h2>
      <p>Vous pouvez me contacter pour discuter d'un projet, d'une collaboration ou d'une opportunité professionnelle.</p>
    </section>
  </TerminalWindow>
</Layout>