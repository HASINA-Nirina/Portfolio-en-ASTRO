---
import TitleBar from './TitleBar.astro';
import Nav from './Nav.astro';
import NavScript from './NavScript.astro';
import MobileDock from './MobileDock.astro';
---
<div class="desktop-backdrop">
  <div class="glow glow-blue"></div>
  <div class="glow glow-green"></div>
  <!-- <div class="grid-overlay"></div> -->
</div>

<div class="terminal-window" id="terminalWindow">
  <TitleBar />
  <Nav />
  <main class="terminal-body" id="terminalBody">
    <slot />
  </main>
</div>
<MobileDock />
<NavScript />

<script>
  const maximizeToggle = document.getElementById('maximizeToggle');
  const terminalWindowEl = document.getElementById('terminalWindow');
  maximizeToggle?.addEventListener('click', () => {
    terminalWindowEl?.classList.toggle('maximized');
  });
</script>