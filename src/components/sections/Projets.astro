---
// Remplace ces exemples par tes vrais projets.
// images: laisse [] pour l'instant (mockup automatique), ou mets des chemins
// comme "/projects/projet1-1.png" une fois tes captures déposées dans public/projects/
const projects = [
  { name: "Projet 1", tools: ["React"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
  { name: "Projet 2", tools: ["Flutter"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
  { name: "Projet 3", tools: ["Next.js"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
  { name: "Projet 4", tools: ["Node.js"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
  { name: "Projet 5", tools: ["Spring Boot"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
  { name: "Projet 6", tools: ["PostgreSQL"], images: [], demo: "#", code: "https://github.com/HASINA-Nirina" },
];
---
<section id="projets" class="section" data-section>
  <p class="eyebrow"><span class="dot"></span> ls -la ./projets</p>
  <h2 class="section-title">Mes Projets Récents</h2>

  <div class="projects-grid">
    {projects.map((p, i) => (
      <div class="project-window" data-images={JSON.stringify(p.images)}>
        <div class="project-titlebar">
          <div class="project-lights"><span></span><span></span><span></span></div>
          <span class="project-path">~/projet-{i + 1}</span>
        </div>

        <div class="project-screen">
          {p.images.length > 0 ? (
            p.images.map((src, idx) => (
              <img src={src} alt={p.name} class:list={["project-slide", { active: idx === 0 }]} />
            ))
          ) : (
            <div class="project-slide active project-mockup">
              <span>{p.name}</span>
            </div>
          )}
        </div>

        <div class="project-footer">
          <h3>{p.name}</h3>
          <div class="project-tools">
            {p.tools.map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="tl-links">
            <a href={p.demo} target="_blank" rel="noopener">Démo</a>
            <a href={p.code} target="_blank" rel="noopener">Code</a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.project-window').forEach((card) => {
    const slides = card.querySelectorAll<HTMLElement>('.project-slide');
    if (slides.length <= 1) return;
    let index = 0;
    setInterval(() => {
      slides[index].classList.remove('active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('active');
    }, 3000);
  });
</script>