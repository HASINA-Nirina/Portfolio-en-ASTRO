---
const projects = [
  {
    name: "Gestion Formation ECAT Taratra",
    tools: ["Next.js 15", "FastAPI", "PostgreSQL", "Tailwind CSS"],
    images: ["/projects/ecat-1.png", "/projects/ecat-2.png", "/projects/ecat-3.png", "/projects/ecat-4.png"],
    demo: "#",
    code: "https://github.com/HASINA-Nirina",
  },
  {
    name: "Quiz Battle Géolocalisé",
    tools: ["Flutter", "Dart", "Supabase", "Socket.io"],
    images: ["/projects/quiz-1.png", "/projects/quiz-2.png", "/projects/quiz-3.png"],
    demo: "https://quizgame-site-production.up.railway.app",
    code: "https://github.com/HASINA-Nirina",
  },
  {
    name: "Cosmétique E-commerce",
    tools: ["Spring Boot", "PostgreSQL", "React", "Tailwind CSS"],
    images: ["/projects/cosmetique-1.png", "/projects/cosmetique-2.png"],
    demo: "#",
    code: "https://github.com/HASINA-Nirina",
  },
  {
    name: "Ventes aux Enchères en ligne",
    tools: ["React (Next.js)", "Node.js", "PostgreSQL"],
    images: ["/projects/encheres-1.png", "/projects/encheres-2.png", "/projects/encheres-3.png"],
    demo: "#",
    code: "https://github.com/HASINA-Nirina",
  },
  {
    name: "Gestion des Notes des Élèves",
    tools: ["C++", "Qt Creator", "XAMPP"],
    images: ["/projects/notes-1.png"],
    demo: "#",
    code: "https://github.com/HASINA-Nirina",
  },
  {
    name: "Prochain projet",
    tools: ["À venir"],
    images: [],
    demo: "#",
    code: "https://github.com/HASINA-Nirina",
  },
];
---
<section id="projets" class="section" data-section>
  <p class="eyebrow"><span class="dot"></span> ls -la ./projets</p>
  <h2 class="section-title">Mes Projets Récents</h2>

  <div class="projects-grid">
    {projects.map((p, i) => (
      <div class="project-window">
        <div class="project-titlebar">
          <div class="project-lights"><span></span><span></span><span></span></div>
          <span class="project-path">~/projet-{i + 1}</span>
        </div>

        <div class="project-screen">
          {p.images.length > 0 ? (
            p.images.map((src, idx) => (
              <img src={src} alt={p.name} class:list={["project-slide", { active: idx === 0 }]} loading="lazy" />
            ))
          ) : (
            <div class="project-slide active project-mockup">
              <span>{p.name}</span>
            </div>
          )}
        </div>

        <div class="project-footer">
          <h3>{p.name}</h3>
          <div class="project-tools">
            {p.tools.map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="tl-links">
            <a href={p.demo} target="_blank" rel="noopener">Démo</a>
            <a href={p.code} target="_blank" rel="noopener">Code</a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.project-window').forEach((card) => {
    const slides = card.querySelectorAll<HTMLElement>('.project-slide');
    if (slides.length <= 1) return;
    let index = 0;
    setInterval(() => {
      slides[index].classList.remove('active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('active');
    }, 3000);
  });
</script>