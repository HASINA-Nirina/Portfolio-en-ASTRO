---
const projects = [
  {
    name: "Formation en Ligne — ECAT Taratra",
    desc: "Plateforme de formation à distance pour l'université ECAT Taratra Fianarantsoa, permettant l'achat de livres et vidéos de cours, le paiement via Mobile Money, et l'échange entre étudiants via un forum de discussion intégré.",
    tools: ["Next.js 15", "FastAPI", "PostgreSQL", "Tailwind CSS"],
    images: ["/projects/ecat-1.png", "/projects/ecat-2.png", "/projects/ecat-3.png", "/projects/ecat-4.png"],
  },
  {
    name: "Quiz Battle Géolocalisé",
    desc: "Application mobile de quiz multijoueur en temps réel, avec géolocalisation entre amis, catégories de questions variées et plusieurs niveaux de difficulté.",
    tools: ["Flutter", "Dart", "Supabase", "Socket.io"],
    images: ["/projects/quiz-1.png", "/projects/quiz-2.png"],
  },
  {
    name: "Serveur de Messagerie Sécurisé",
    desc: "Application desktop implémentant un serveur de messagerie instantanée nécessitant une authentification des utilisateurs. La communication entre le serveur et les clients repose sur des sockets réseau TCP, avec un stockage sécurisé des mots de passe.",
    tools: ["Python", "Sockets TCP", "Tkinter", "bcrypt"],
    images: ["/projects/serveur1.png", "/projects/serveur2.png", "/projects/serveur3.png", "/projects/serveur4.png"],
  },
  {
    name: "Ventes aux Enchères en ligne",
    desc: "Plateforme full-stack de ventes aux enchères en ligne : les utilisateurs publient des articles et placent des offres en temps réel, avec mise à jour instantanée du prix et du compte à rebours jusqu'à la clôture de chaque enchère.",
    tools: ["React", "Node.js", "MySQL"],
    images: ["/projects/encheres-1.png", "/projects/encheres-2.png", "/projects/encheres-3.png", "/projects/encheres-4.png", "/projects/encheres-5.png", "/projects/encheres-6.png"],
  },
  {
    name: "Problème du Voyageur de Commerce — Algorithme de Little",
    desc: "Application web résolvant le problème du voyageur de commerce grâce à l'algorithme de Little (méthode de séparation et évaluation), avec sauvegarde des données directement dans le navigateur via le Local Storage.",
    tools: ["React", "Tailwind CSS", "Local Storage"],
    images: ["/projects/pvc-little1.png", "/projects/pvc-little2.png", "/projects/pvc-little3.png", "/projects/pvc-little4.png"],
  },
  {
    name: "Astro Strike — Jeu de Tir Spatial",
    desc: "Jeu d'arcade de tir spatial développé en Python, où le joueur pilote un vaisseau et affronte des vagues d'ennemis dans un décor étoilé, avec gestion des collisions, des tirs et des niveaux de difficulté croissants.",
    tools: ["Python", "Pygame"],
    images: ["/projects/rocket-2.png", "/projects/rocket-3.png", "/projects/rocket-4.png"],
  },
];
---
<section id="projets" class="section" data-section>
  <p class="eyebrow"><span class="dot"></span> ls -la ./projets</p>
  <h2 class="section-title">Mes Projets Récents</h2>

  <div class="projects-grid">
    {projects.map((p, i) => (
      <div class="project-window" data-project-index={i} tabindex="0" role="button" aria-label={`Voir le détail de ${p.name}`}>
        <div class="project-titlebar">
          <div class="project-lights"><span></span><span></span><span></span></div>
          <span class="project-path">~/projet-{i + 1}</span>
        </div>

        <div class="project-screen">
          {p.images.length > 0 ? (
            p.images.map((src, idx) => (
              <img src={src} alt={p.name} class:list={["project-slide", { active: idx === 0 }]} loading="lazy" />
            ))
          ) : (
            <div class="project-slide active project-mockup">
              <span>{p.name}</span>
            </div>
          )}
          <div class="project-expand-hint">🔍 Cliquer pour agrandir</div>
        </div>

        <div class="project-footer">
          <h3>{p.name}</h3>
          <p class="project-desc">{p.desc}</p>
          <div class="project-tools">
            {p.tools.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal détail projet -->
  <div class="project-modal-overlay" id="projectModalOverlay">
    <div class="lightbox-window project-modal-window">
      <div class="lightbox-titlebar">
        <span class="lightbox-light red" id="projectModalClose" role="button" aria-label="Fermer"></span>
        <span class="lightbox-light yellow"></span>
        <span class="lightbox-light green"></span>
        <span class="lightbox-path" id="projectModalPath"></span>
      </div>
      <div class="project-modal-body">
        <div class="project-modal-screen">
          <button class="project-modal-nav prev" id="projectModalPrev" aria-label="Image précédente">‹</button>
          <img src="" alt="" id="projectModalImg" draggable="false" oncontextmenu="return false" />
          <button class="project-modal-nav next" id="projectModalNext" aria-label="Image suivante">›</button>
        </div>
        <div class="project-modal-info">
          <h3 id="projectModalTitle"></h3>
          <p id="projectModalDesc"></p>
          <div class="project-tools" id="projectModalTools"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ projects }}>
  // Carrousel automatique de chaque carte (aperçu de la grille)
  document.querySelectorAll('.project-window').forEach((card) => {
    const slides = card.querySelectorAll('.project-slide');
    if (slides.length > 1) {
      let index = 0;
      setInterval(() => {
        slides[index].classList.remove('active');
        index = (index + 1) % slides.length;
        slides[index].classList.add('active');
      }, 3000);
    }
  });

  // Modal détail projet
  const overlay = document.getElementById('projectModalOverlay');
  const modalImg = document.getElementById('projectModalImg');
  const modalTitle = document.getElementById('projectModalTitle');
  const modalDesc = document.getElementById('projectModalDesc');
  const modalTools = document.getElementById('projectModalTools');
  const modalPath = document.getElementById('projectModalPath');
  const btnPrev = document.getElementById('projectModalPrev');
  const btnNext = document.getElementById('projectModalNext');
  const btnClose = document.getElementById('projectModalClose');

  let currentProject = null;
  let currentImgIndex = 0;

  function renderModalImage() {
    if (!currentProject) return;
    const imgs = currentProject.images;
    if (imgs.length === 0) return;
        modalImg.src = imgs[currentImgIndex];
  }

  function openModal(index) {
    currentProject = projects[index];
    currentImgIndex = 0;

    modalTitle.textContent = currentProject.name;
    modalDesc.textContent = currentProject.desc;
    modalPath.textContent = '~/projet-' + (index + 1);

    modalTools.innerHTML = '';
    currentProject.tools.forEach((t) => {
      const span = document.createElement('span');
      span.className = 'tag';
      span.textContent = t;
      modalTools.appendChild(span);
    });

    const hasMultiple = currentProject.images.length > 1;
    btnPrev.style.display = hasMultiple ? 'flex' : 'none';
    btnNext.style.display = hasMultiple ? 'flex' : 'none';

    renderModalImage();
    overlay.classList.add('open');
  }

  function closeModal() {
    overlay.classList.remove('open');
  }

  const isMobileView = () => window.matchMedia('(max-width: 820px)').matches;

  document.querySelectorAll('.project-window').forEach((card) => {
    card.addEventListener('click', () => {
      if (!isMobileView()) return;
      const idx = parseInt(card.dataset.projectIndex, 10);
      openModal(idx);
    });
    card.addEventListener('keydown', (e) => {
      if (!isMobileView()) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const idx = parseInt(card.dataset.projectIndex, 10);
        openModal(idx);
      }
    });
  });

  btnPrev.addEventListener('click', () => {
    if (!currentProject) return;
    currentImgIndex = (currentImgIndex - 1 + currentProject.images.length) % currentProject.images.length;
    renderModalImage();
  });
  btnNext.addEventListener('click', () => {
    if (!currentProject) return;
    currentImgIndex = (currentImgIndex + 1) % currentProject.images.length;
    renderModalImage();
  });

  btnClose.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if (overlay.classList.contains('open')) {
      if (e.key === 'ArrowLeft') btnPrev.click();
      if (e.key === 'ArrowRight') btnNext.click();
    }
  });

    window.addEventListener('resize', () => {
    if (!isMobileView() && overlay.classList.contains('open')) {
      closeModal();
    }
  });
</script>