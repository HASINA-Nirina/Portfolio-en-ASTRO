---
import { Image } from 'astro:assets';
import certPhoto from '../../assets/certificates/ethical-hacking.png';
---
<section id="formation" class="section" data-section>
  <p class="eyebrow"><span class="dot"></span> cat formation.json</p>
  <h2 class="section-title">Formations &amp; Certification</h2>

  <div class="edu-tree">

    <div class="tree-node">
      <div class="tree-dot"></div>
      <div class="tree-card">
        <span class="edu-year">2021 – 2022</span>
        <h3>Baccalauréat — Série D</h3>
        <p>Lycée Saint Louis de Gonzague — Mahasoabe, Fianarantsoa</p>
      </div>
    </div>

    <div class="tree-node">
      <div class="tree-dot"></div>
      <div class="tree-card">
        <span class="edu-year">2022 – 2023</span>
        <h3>Licence 1 — Informatique Générale</h3>
        <p>École Nationale d'Informatique (ENI) — Fianarantsoa</p>
      </div>
    </div>

    <div class="tree-node">
      <div class="tree-dot"></div>
      <div class="tree-card">
        <span class="edu-year">2023 – 2024</span>
        <h3>Licence 2 — Informatique Générale</h3>
        <p>École Nationale d'Informatique (ENI) — Fianarantsoa</p>
      </div>

      <div class="tree-branch">
        <div class="tree-branch-connector"></div>
        <div class="tree-card tree-card-cert">
          <button class="cert-trigger" data-lightbox-src={certPhoto.src} aria-label="Agrandir le certificat">
            <Image
              src={certPhoto}
              alt="Certificat de formation Cybersécurité / Ethical Hacking"
              width={400}
              height={240}
              class="edu-img cert-img"
              draggable="false"
              oncontextmenu="return false"
            />
            <span class="cert-zoom-hint">🔍 Cliquer pour agrandir</span>
          </button>
          <div class="edu-card-body">
            <span class="edu-year">Formation de 3 mois</span>
            <h3>Cybersécurité — Ethical Hacking</h3>
            <p>Niveau débutant à avancé, obtenue au CFT Fianarantsoa, réalisée durant la 2ᵉ année (L2)</p>
          </div>
        </div>
      </div>
    </div>

    <div class="tree-node">
      <div class="tree-dot"></div>
      <div class="tree-card">
        <span class="edu-year">2024 – 2025</span>
        <h3>Licence 3 — Informatique Générale</h3>
        <p>École Nationale d'Informatique (ENI) — Fianarantsoa</p>
      </div>
    </div>

    <div class="tree-node tree-node-current">
      <div class="tree-dot tree-dot-current"></div>
      <div class="tree-card">
        <span class="edu-year">2025 – 2026</span>
        <h3>Master 1 — Informatique Générale</h3>
        <p>École Nationale d'Informatique (ENI) — Fianarantsoa</p>
        <span class="edu-badge">En cours</span>
      </div>
    </div>

  </div>

  <!-- Lightbox -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <img src="" alt="Certificat agrandi" id="lightboxImg" draggable="false" oncontextmenu="return false" />
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLElement>('.cert-trigger');
  const overlay = document.getElementById('lightboxOverlay');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.lightboxSrc;
      if (src && lightboxImg && overlay) {
        lightboxImg.src = src;
        overlay.classList.add('open');
      }
    });
  });

  overlay?.addEventListener('click', () => overlay.classList.remove('open'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') overlay?.classList.remove('open');
  });

  // Blocage global du clic droit et du glisser-déposer sur les images de la section formation
  document.querySelectorAll<HTMLImageElement>('#formation img, #lightboxImg').forEach((img) => {
    img.addEventListener('contextmenu', (e) => e.preventDefault());
    img.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>