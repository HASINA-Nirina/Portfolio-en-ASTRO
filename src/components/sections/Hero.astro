---
import { Image } from 'astro:assets';
import profilePhoto from '../../assets/profile.png';
---
<section id="accueil" class="section section-hero" data-section>
  <div class="hero-grid">
    <div class="hero-photo-wrap">
      <div class="hero-photo-glow"></div>
      <Image src={profilePhoto} alt="Photo de Hasinirina Jean de Dieu" width={280} height={280} class="hero-photo" />
      <span class="hero-badge">Frontend Developer</span>
    </div>
    <div class="hero-content">
      <p class="eyebrow"><span class="dot"></span> whoami</p>
      <h1 class="hero-name">Bonjour, je suis <span class="hero-name-highlight">HASINIRINA Jean de Dieu</span></h1>
      <p class="hero-sub">Étudiant en Informatique Générale à l'ENI Fianarantsoa</p>
      <p class="hero-desc">Passionné par le développement web <span class="tag">React</span> <span class="tag">Next.js</span> et mobile <span class="tag">Flutter</span>.</p>
      <div class="hero-actions">
        <a href="#projets" class="btn btn-primary" data-target="projets">Voir mes projets</a>
        <a href="/Hasina CV.pdf" download class="btn btn-ghost">Télécharger mon CV</a>
      </div>
    </div>
  </div>
</section>