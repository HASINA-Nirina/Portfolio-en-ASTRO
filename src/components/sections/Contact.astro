---
---
<section id="contact" class="section" data-section>
  <p class="eyebrow"><span class="dot"></span> ./send-message.sh</p>
  <h2 class="section-title">Travaillons Ensemble</h2>
  <p class="contact-intro">Je suis toujours enthousiaste à l'idée de travailler sur des projets intéressants. Que vous ayez besoin d'une application web, mobile, ou d'une refonte d'interface — écrivons quelque chose d'impressionnant ensemble !</p>

  <div class="contact-wrap">
    <form class="contact-form" id="contactForm">
      <label>
        Nom
        <input type="text" name="name" required placeholder="Votre nom" />
      </label>
      <label>
        Email
        <input type="email" name="email" required placeholder="vous@exemple.com" />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required placeholder="Votre message..."></textarea>
      </label>
      <button type="submit" class="btn btn-primary btn-block">Envoyer un email</button>
    </form>

    <div class="contact-info">
      <a class="contact-row" href="tel:+261386463000">📞 +261 38 64 630 00</a>
      <a class="contact-row" href="mailto:jeandedieuhasinirina82@gmail.com">✉️ jeandedieuhasinirina82@gmail.com</a>
      <div class="social-row">
        <a href="https://github.com/HASINA-Nirina" target="_blank" rel="noopener" class="social-btn" aria-label="GitHub">🐙</a>
        <a href="https://www.facebook.com/NirinaHasina" target="_blank" rel="noopener" class="social-btn" aria-label="Facebook">📘</a>
      </div>
    </div>
  </div>

  <footer class="site-footer">
    <p>© <span id="year"></span> HASINIRINA Jean de Dieu — Créé avec passion et une bonne dose de café ☕.</p>
  </footer>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name');
    const email = data.get('email');
    const message = data.get('message');
    const subject = encodeURIComponent('Message depuis le portfolio de ' + name);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
    window.location.href = `mailto:jeandedieuhasinirina82@gmail.com?subject=${subject}&body=${body}`;
  });

  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>