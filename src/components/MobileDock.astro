---
const links = [
  { id: 'accueil', label: 'Accueil', icon: 'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z M9 22V12h6v10' },
  { id: 'profil', label: 'Profil', icon: 'M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2 M12 11a4 4 0 100-8 4 4 0 000 8z' },
  { id: 'competences', label: 'Compétances', icon: 'M12 2l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z' },
  { id: 'projets', label: 'Projets', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
  { id: 'formation', label: 'Formation', icon: 'M22 10v6 M2 10l10-5 10 5-10 5-10-5z M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5' },
  { id: 'contact', label: 'Contact', icon: 'M22 6l-10 7L2 6 M2 6h20v12H2z' },
];
---
<nav class="mobile-dock" id="mobileDock" aria-label="Navigation mobile">
  {links.map((link, i) => (
    <a
      href={'#' + link.id}
      class:list={["dock-link", { active: i === 0 }]}
      data-target={link.id}
      aria-label={link.label}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d={link.icon} />
      </svg>
      <span>{link.label}</span>
    </a>
  ))}
  <div class="dock-indicator" id="dockIndicator"></div>
</nav>